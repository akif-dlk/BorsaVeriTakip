# Kopyala: cp .env.example .env  (.env git'e girmez)
POSTGRES_USER=bvt
POSTGRES_PASSWORD=bvt
POSTGRES_DB=borsa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opsiyonel: TCMB EVDS anahtarı (https://evds2.tcmb.gov.tr). Boşsa döviz yfinance'ten çekilir.
EVDS_API_KEY=
# EVDS servis adresi değişirse buradan güncellenir (varsayılan: https://evds2.tcmb.gov.tr/service/evds/)
EVDS_BASE_URL=

# Günlük çalışmada geriye kaç gün yeniden çekilir (idempotent; kaçırılan günleri/revizyonları yakalar)
BVT_LOOKBACK_DAYS=7
# Günlük boşluk kontrolünün geriye bakış süresi (gün); sonuç ops.data_gaps tablosuna yazılır
BVT_GAP_CHECK_DAYS=30
# Loglama: seviye (DEBUG/INFO/WARNING) ve biçim (text | json; json log toplayıcılar için tek satır JSON)
BVT_LOG_LEVEL=INFO
BVT_LOG_FORMAT=text
# dbt test raporunun (test_report.md / .json) yazılacağı dizin; boşsa dbt hedef dizini (dbt/target)
BVT_REPORT_DIR=

# Airflow (http://localhost:8080). Yerel geliştirme varsayılanları; paylaşılan ortamda değiştirin.
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Linux'ta log klasörü izinleri için: echo "AIRFLOW_UID=$(id -u)" >> .env  (Windows/macOS'ta 50000 kalabilir)
AIRFLOW_UID=50000
# Boş bırakılabilir. Bağlantı şifrelerini şifrelemek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=

# Hafta 2'de alarm için
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
