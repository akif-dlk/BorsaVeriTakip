# Kopyala: cp .env.example .env  (.env git'e girmez)
POSTGRES_USER=bvt
POSTGRES_PASSWORD=bvt
POSTGRES_DB=borsa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opsiyonel: TCMB EVDS anahtarı (https://evds2.tcmb.gov.tr). Boşsa döviz yfinance'ten çekilir.
EVDS_API_KEY=
# EVDS servis adresi değişirse buradan güncellenir (varsayılan: https://evds2.tcmb.gov.tr/service/evds/)
EVDS_BASE_URL=

# Hafta 2'de alarm için
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
