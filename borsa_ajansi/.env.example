# Anthropic
ANTHROPIC_API_KEY=
FAST_MODEL=claude-haiku-5-5
REASONING_MODEL=claude-opus-5-5
FAST_EFFORT=low
REASONING_EFFORT=medium

# Google Gemini (ANTHROPIC_API_KEY yoksa otomatik kullanılır)
GEMINI_API_KEY=
# Opsiyonel: ana anahtar hesap/kredi hatasi verirse kullanilacak ikinci anahtar
GEMINI_API_KEY_BACKUP=
# Tek Gemini isteği için en fazla bekleme (sn); askıda kalan istek döngüyü kilitlemesin
GEMINI_TIMEOUT_S=120
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite,gemini-3.6-flash
GEMINI_REASONING_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash
# auto | anthropic | gemini (katman bazında)
# EVREN (yerli LLM ağ geçidi, OpenAI uyumlu). Varsa birincil sağlayıcı olur, Gemini yedekte kalır.
EVREN_API_KEY=
EVREN_FAST_MODELS=deepseek-v4.1-flash,qwen3.8-flash-next
EVREN_REASONING_MODELS=glm-5.3,deepseek-v4.1-flash
EVREN_TIMEOUT_S=150
EVREN_MAX_CONCURRENCY=2
FAST_PROVIDER=auto
REASONING_PROVIDER=auto

# Telegram
TELEGRAM_BOT_TOKEN=
# Virgülle ayrılmış sayısal Telegram kullanıcı ID'leri (öğrenmek için @userinfobot)
ALLOWED_TELEGRAM_USER_ID=

# Zamanlanmış rapor
WATCHLIST=THYAO.IS,ASELS.IS,GARAN.IS
REPORT_HOUR=9
REPORT_MINUTE=30
TIMEZONE=Europe/Istanbul

DB_PATH=borsa_ajansi.db

# ---- Sanal portföy simülasyonu (gerçek para yok) ----
SIM_INITIAL_CASH=10000
SIM_DAYS=14
SIM_CANDIDATES=3
SIM_MAX_POSITIONS=4
SIM_RISK_PER_TRADE_PCT=2
SIM_MAX_POSITION_PCT=30
SIM_COMMISSION_PCT=0.2
SIM_SLIPPAGE_PCT=0.1
SIM_TRADE_HOUR=10
SIM_TRADE_MINUTE=30
SIM_EOD_HOUR=18
SIM_EOD_MINUTE=30
# Boş -> BIST30. Örn: UNIVERSE=THYAO,GARAN,ASELS
UNIVERSE=

# ---- Kota tasarrufu (Gemini ücretsiz katman: model başına günde ~20 istek) ----
MIN_DEBATE_ROUNDS=2
MAX_DEBATE_ROUNDS=3
MORNING_REPORT_ENABLED=true
